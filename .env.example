# Copy the web block to apps/web/.env.local (Vi) and the brain block to services/brain/.env (Kris).
# Never commit real values.

# ---------- Web: apps/web/.env.local ----------
NEXT_PUBLIC_BRAIN_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=1
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Brain: services/brain/.env ----------
# Oriane: account on oriane.xyz (same email as Luma). Key and REST base URL from the dashboard or the kickoff demo.
ORIANE_API_KEY=
ORIANE_BASE_URL=

# GMI Cloud serverless, OpenAI-compatible. Credits handed out at check-in. Key: console.gmicloud.ai
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
# Confirm exact IDs with: curl -s $GMI_BASE_URL/models -H "Authorization: Bearer $GMI_API_KEY"
GMI_LLM_MODEL=deepseek-ai/DeepSeek-V3.2
GMI_LLM_FAST_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
GMI_VLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-Omni

# GMI Cloud sandbox (pip install gmi-sandbox-sdk)
GMI_SANDBOX_API_KEY=
GMI_SANDBOX_IDC_NAME=gmi-sandbox-us

# Jev via the System One API.
# OpenRouter: JEV_BASE_URL=https://openrouter.ai/api and your OpenRouter key, model jev-1.13
# TypeSafe direct: JEV_BASE_URL=https://api.typesafe.ai
# Leave JEV_API_KEY empty to use the GMI LLM judge fallback.
JEV_BASE_URL=https://openrouter.ai/api
JEV_API_KEY=
JEV_MODEL=jev-1.13

# PubMed E-utilities (optional email/key; key raises the rate limit)
NCBI_EMAIL=
NCBI_API_KEY=

# CORS for the web app
ALLOWED_ORIGINS=http://localhost:3000
