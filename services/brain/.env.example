ORIANE_API_KEY=
# Full REST video search URL (base URL plus path) from the Oriane dashboard or kickoff.
ORIANE_SEARCH_URL=

GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
# Candidate IDs from the project docs. Confirm them in the authenticated catalog.
GMI_LLM_MODEL=deepseek-ai/DeepSeek-V3.2
GMI_LLM_FAST_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
GMI_VLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-Omni

# Optional. These defaults use DigitalOcean's System One endpoint.
JEV_API_KEY=
JEV_BASE_URL=https://inference.do-ai.run
JEV_MODEL=typesafe-jev-1.13.0

# Comma-separated additional origins, including the actual Vercel frontend URL.
ALLOWED_ORIGINS=
