ORIANE_API_KEY=
ORIANE_SEARCH_URL=https://connect.oriane.xyz/rest/contents/search

# Chat model for briefs, evidence, live check and judge. Defaults to OpenAI.
# To run every call on GMI Cloud: OPENAI_BASE_URL=https://api.gmi-serving.com/v1,
# OPENAI_API_KEY=<GMI inference key>, OPENAI_MODEL=<an id from GET $GMI_BASE_URL/models>.
# Unset OPENAI_BASE_URL to go back to OpenAI.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Comma-separated additional origins, including the actual Vercel frontend URL.
ALLOWED_ORIGINS=https://mybuster.vercel.app

# Optional PubMed E-utilities credentials.
NCBI_EMAIL=
NCBI_API_KEY=

# GMI Inference Engine for video frame transcription and the /health gmi flag.
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_VLM_MODEL=google/gemini-3.5-flash-lite

# Shared server-only token for the web app to call the brain for post fact-checks.
FACT_CHECK_API_TOKEN=
# Optional model on OPENAI_BASE_URL for post fact-checks. Defaults to OPENAI_MODEL.
FACT_CHECK_MODEL=
